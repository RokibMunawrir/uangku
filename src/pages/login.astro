---
import Layout from '../layouts/Layout.astro';
import LoginForm from '../components/auth/LoginForm';
import { auth } from '../lib/auth';

// Redirect if already logged in
const session = await auth.api.getSession({
  headers: Astro.request.headers
});

if (session) {
  return Astro.redirect('/dashboard');
}
---

<Layout title="Masuk ke Akun Anda — Uangku" description="Masuk ke akun Uangku Anda dengan email & kata sandi atau Google OAuth untuk memantau data finansial terenkripsi secara instan.">
  <main class="min-h-screen bg-bg-custom flex overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-12 w-full">
      
      {/* Left side: Premium Fintech SaaS Showcase (Illustration/Marketing) */}
      <div class="hidden lg:flex lg:col-span-6 bg-gradient-to-tr from-primary-custom via-[#7a72ff] to-[#a29eff] relative overflow-hidden flex-col justify-between p-12 select-none">
        
        {/* Soft UI Background Decors */}
        <div class="absolute -top-20 -left-20 w-80 h-80 rounded-full bg-white/10 blur-3xl"></div>
        <div class="absolute -bottom-40 -right-20 w-96 h-96 rounded-full bg-[#E0E5EC]/15 blur-3xl"></div>
        
        {/* Branding */}
        <div class="flex items-center gap-3 relative z-10">
          <div class="w-12 h-12 rounded-[16px] bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-2xl font-bold shadow-lg">
            💸
          </div>
          <div>
            <h1 class="text-xl font-extrabold text-white tracking-tight leading-none">Uangku</h1>
            <p class="text-[9px] font-bold text-white/80 tracking-widest uppercase mt-1">Personal Finance</p>
          </div>
        </div>

        {/* Feature Highlights */}
        <div class="my-auto relative z-10 max-w-md flex flex-col gap-8">
          <h2 class="text-4xl font-extrabold text-white leading-tight">
            Kembali Pantau Masa Depan Finansialmu 🚀
          </h2>
          <p class="text-base text-white/90 font-medium leading-relaxed">
            Masuk secara aman ke ruang finansial pribadi Anda. Catat pemasukan tambahan, alokasikan sisa dana bulanan, dan tinjau performa statistik grafik dengan visual yang halus.
          </p>

          {/* Floating Glass Card (Financial Transactions Mock) */}
          <div class="p-6 rounded-[24px] bg-white/10 backdrop-blur-lg border border-white/20 shadow-2xl flex flex-col gap-4 max-w-sm transform hover:scale-[1.02] transition-all duration-300">
            <h4 class="text-xs font-bold text-white/85 uppercase tracking-widest">Contoh Transaksi Terbaru</h4>
            <div class="flex items-center justify-between text-white">
              <div class="flex items-center gap-3">
                <span class="text-xl">🍔</span>
                <div class="flex flex-col">
                  <span class="text-xs font-bold">Makan Siang Enak</span>
                  <span class="text-[9px] text-white/70">Hari ini, 12:30</span>
                </div>
              </div>
              <span class="text-xs font-extrabold text-[#FF5C5C]">- Rp 120.000</span>
            </div>
            <div class="flex items-center justify-between text-white">
              <div class="flex items-center gap-3">
                <span class="text-xl">💼</span>
                <div class="flex flex-col">
                  <span class="text-xs font-bold">Gaji Bulanan Utama</span>
                  <span class="text-[9px] text-white/70">Kemarin, 09:00</span>
                </div>
              </div>
              <span class="text-xs font-extrabold text-[#4CAF50]">+ Rp 7.500.000</span>
            </div>
          </div>
        </div>

        {/* Footer info */}
        <div class="relative z-10 flex items-center justify-between text-xs text-white/70 font-semibold">
          <span>© 2026 Uangku App. All rights reserved.</span>
          <div class="flex gap-4">
            <a href="#" class="hover:text-white transition-colors">Privasi</a>
            <a href="#" class="hover:text-white transition-colors">Syarat</a>
          </div>
        </div>
      </div>

      {/* Right side: Login Form */}
      <div class="col-span-1 lg:col-span-6 flex items-center justify-center py-10 min-h-screen overflow-y-auto px-4 sm:px-6">
        <LoginForm client:load />
      </div>

    </div>
  </main>
</Layout>
