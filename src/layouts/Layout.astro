---
import '../assets/styles/global.css';

const { title = 'Uangku', description = 'Catat Keuangan Pribadi Gratis!' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content="Uangku Team" />
		<meta name="theme-color" content="#6C63FF" />
		<meta name="keywords" content="Uangku, Catat Keuangan, Pribadi, Aplikasi Keuangan, Gratis, Gratis, Aplikasi Gratis" />
		<title>{title}</title>
	</head>
	<body class="antialiased font-sans bg-bg-custom text-dark-custom overflow-x-hidden min-h-screen">
		<slot />
	</body>
</html>